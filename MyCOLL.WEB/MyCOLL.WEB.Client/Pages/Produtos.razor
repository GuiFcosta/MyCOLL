@page "/produtos"
@using MyCOLL.Shared
@using MyCOLL.Shared.Models.Dto  @* <--- IMPORTANTE: Adiciona esta linha! *@
@using System.Net.Http.Json
@using MyCOLL.Shared.Models
@inject HttpClient Http

<PageTitle>Produtos</PageTitle>

<h1>Lista de Produtos</h1>

@if (produtos == null)
{
    <p><em>A carregar...</em></p>
}
else
{
    <table class="table">
        <thead>
        <tr>
            <th>Nome</th>
            <th>Preço</th>
        </tr>
        </thead>
        <tbody>
        @foreach (var produto in produtos)
        {
            <tr>
                @* Verifica se no ProductDto.cs as propriedades são Name e Price mesmo *@
                <td>@produto.Name</td> 
                <td>@produto.Price</td>
            </tr>
        }
        </tbody>
    </table>
}

@code {
    // Muda de Product para ProductDto
    private List<ProductDto>? produtos; 

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Muda aqui também!
            produtos = await Http.GetFromJsonAsync<List<ProductDto>>("api/Product");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro: {ex.Message}");
        }
    }
}