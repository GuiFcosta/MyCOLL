@using Microsoft.AspNetCore.Components.Authorization
@using MyCOLL.Shared.Constants
@using MyCOLL.Shared.Interface
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavManager

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">MyCOLL Loja</a>
        <button title="Navigation menu" class="navbar-toggler" @onclick="ToggleNavMenu">
            <span class="navbar-toggler-icon"></span>
        </button>
    </div>
</div>

<div class="@NavMenuCssClass" @onclick="ToggleNavMenu">
    <nav class="flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Início
            </NavLink>
        </div>

        <AuthorizeView>
            <Authorized>
                @if (context.User.IsInRole(UserRoles.Supplier))
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="products/my-list">
                            <span class="bi bi-box-seam-nav-menu" aria-hidden="true"></span> Meus Produtos
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="products/create">
                            <span class="bi bi-plus-circle-nav-menu" aria-hidden="true"></span> Novo Produto
                        </NavLink>
                    </div>
                }

                @if (context.User.IsInRole(UserRoles.Client))
                {
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="cart">
                            <span class="bi bi-cart-fill-nav-menu" aria-hidden="true"></span> Carrinho
                        </NavLink>
                    </div>
                    <div class="nav-item px-3">
                        <NavLink class="nav-link" href="orders/history">
                            <span class="bi bi-clock-history-nav-menu" aria-hidden="true"></span> Minhas Compras
                        </NavLink>
                    </div>
                }

                <div class="nav-item px-3 mt-4">
                    <button class="nav-link btn btn-link text-danger" @onclick="Logout">
                        <span class="bi bi-box-arrow-right-nav-menu" aria-hidden="true"></span> Sair
                    </button>
                </div>
            </Authorized>
            
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="login">
                        <span class="bi bi-person-circle-nav-menu" aria-hidden="true"></span> Entrar / Registar
                    </NavLink>
                </div>
            </NotAuthorized>
        </AuthorizeView>
    </nav>
</div>

@code {
    private bool _collapseNavMenu = true;
    private string? NavMenuCssClass => _collapseNavMenu ? "collapse" : null;

    private void ToggleNavMenu()
    {
        _collapseNavMenu = !_collapseNavMenu;
    }

    private async Task Logout()
    {
        if (AuthStateProvider is IAuthService authService)
        {
            await authService.Logout();
            NavManager.NavigateTo("/login");
        }
    }
}