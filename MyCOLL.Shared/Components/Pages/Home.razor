@page "/"
@using MyCOLL.Shared.Models.Dto
@inject HttpClient Http
@using MyCOLL.Shared.Services
@inject CartService CartService  
@inject NavigationManager NavManager
<PageTitle>Início - MyCOLL</PageTitle>

<style>
    .cat-box {
        background: linear-gradient(135deg, var(--cor-topo, #00c2e0), #0090a8);
        aspect-ratio: 1/1;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
        text-align: center;
        padding: 10px;
    }

    .cat-box:hover {
        transform: translateY(-5px) scale(1.02);
        box-shadow: 0 10px 20px rgba(0, 194, 224, 0.3);
        cursor: pointer;
    }

    .cat-link {
        text-decoration: none;
        color: white;
    }
</style>

<div class="mb-5">
    <h3 class="mb-4" style="color: var(--cor-topo, #00bcd4); font-weight: 800;">📂 Navegar por Categorias</h3>

    @if (categorias == null)
    {
        <div class="text-center py-3">
            <div class="spinner-grow text-info" role="status"></div>
            <p class="text-muted small mt-2">A carregar categorias...</p>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var cat in categorias)
            {
                <div class="col-6 col-md-3 col-lg-2">
                    <a href="categoria/@cat.Id" class="cat-link">
                        <div class="cat-box shadow-sm">
                           <div>
                                <h5 class="fw-bold m-0">@cat.Name</h5>
                           </div>
                        </div>
                    </a>
                </div>
            }
        </div>
    }
</div>

<h3 class="mb-4" style="color: var(--cor-topo, #00bcd4); font-weight: 800;">🌟 Destaques da Semana</h3>

@if (produtos == null)
{
    <div class="d-flex justify-content-center p-5">
        <div class="spinner-border text-info" role="status"></div>
    </div>
}
else
{
    <div class="row row-cols-1 row-cols-md-3 row-cols-lg-4 g-4">
        @foreach (var p in produtos)
        {
            <div class="col">
                <div class="card-produto h-100 shadow-sm p-3" style="background: white; border-radius: 15px;">
                    <div style="height: 180px; overflow: hidden; border-radius: 10px; background-color: #eee; display: flex; align-items: center; justify-content: center;">
                        <img src="@(p.Images?.FirstOrDefault()?.ImageUrl ?? "https://placehold.co/150x150?text=Sem+Foto")" 
                             style="width: 100%; height: 100%; object-fit: cover;" 
                             alt="@p.Name" 
                             onerror="this.src='https://placehold.co/150x150?text=Erro+Img'" />
                    </div>
                    
                    <div class="mt-3 text-center">
                        <h5 class="fw-bold mb-1 text-truncate">@p.Name</h5>
                        <p class="text-muted small mb-2">@p.CategoryName</p>
                        <h4 class="text-info fw-bold">@p.FinalPrice.ToString("0.00") €</h4>
                        <button class="btn btn-outline-warning w-100 rounded-pill mt-2 fw-bold"
                                @onclick="()=> AdicionarAoCarrinho(p)">
                            + Adicionar
                        </button>
                    </div>
                </div>
            </div>
        }
    </div>
}

@if (!string.IsNullOrEmpty(erroVisivel))
{
    <div class="alert alert-danger mt-4">
        <strong>Ocorreu um erro:</strong> @erroVisivel
    </div>
}

@code {
    private List<ProductDto>? produtos;
    private List<CategoryDto>? categorias; 
    private string erroVisivel = "";

    protected override async Task OnInitializedAsync()
    {
        try
        {
            // Busca Produtos e Categorias em paralelo
            var taskProdutos = Http.GetFromJsonAsync<List<ProductDto>>("api/Product");
            var taskCategorias = Http.GetFromJsonAsync<List<CategoryDto>>("api/Category");

            await Task.WhenAll(taskProdutos, taskCategorias);

            produtos = await taskProdutos;
            // Apanha só as primeiras 8 categorias para não encher o ecrã
            categorias = (await taskCategorias)?.Take(8).ToList();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"ERRO NA HOME: {ex.Message}");
            erroVisivel = $"Não foi possível carregar a loja. (Erro: {ex.Message})";
        }
        
    }
    private void AdicionarAoCarrinho(ProductDto produto)
    {
        // Chama serviço para guardar o produto
        CartService.AddToCart(produto); 
        
    }
}