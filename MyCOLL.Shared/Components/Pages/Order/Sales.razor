@page "/sales/history"
@using MyCOLL.Shared.Models.Dto
@using Microsoft.AspNetCore.Authorization

@attribute [Authorize(Roles = "Fornecedor")]
@inject HttpClient Http

<div class="container mt-4">
    <h3 class="mb-4"><i class="bi bi-graph-up-arrow"></i> Minhas Vendas</h3>

    @if (_isLoading)
    {
        <div class="text-center mt-5">
            <div class="spinner-border text-primary"></div>
        </div>
    }
    else if (_sales.Count == 0)
    {
        <div class="alert alert-warning text-center">
            <h4>Ainda não realizou vendas.</h4>
            <p>Verifique se os seus produtos estão ativos e com stock!</p>
        </div>
    }
    else
    {
        <div class="row mb-4">
            <div class="col-md-4">
                <div class="card bg-success text-white shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Faturação Total</h5>
                        <h2>@_sales.Sum(s => s.TotalLine).ToString("C")</h2>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card bg-primary text-white shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Itens Vendidos</h5>
                        <h2>@_sales.Sum(s => s.Quantity) un.</h2>
                    </div>
                </div>
            </div>
             <div class="col-md-4">
                <div class="card bg-info text-white shadow-sm">
                    <div class="card-body">
                        <h5 class="card-title">Vendas Recentes</h5>
                        <h2>@_sales.Count(s => s.OrderDate > DateTime.Now.AddDays(-30))</h2>
                        <small>Últimos 30 dias</small>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow">
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Data</th>
                                <th>Produto</th>
                                <th>Qtd</th>
                                <th>Valor Unit.</th>
                                <th>Total</th>
                                <th>Cliente</th>
                                <th>Estado da Encomenda</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var sale in _sales)
                            {
                                <tr>
                                    <td>
                                        <div class="fw-bold">@sale.OrderDate.ToShortDateString()</div>
                                        <small class="text-muted">#@sale.OrderId</small>
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            @if (!string.IsNullOrEmpty(sale.ProductImage))
                                            {
                                                <img src="@GetFullUrl(sale.ProductImage)" 
                                                     class="rounded me-2" 
                                                     style="width: 40px; height: 40px; object-fit: cover;" />
                                            }
                                            <span>@sale.ProductName</span>
                                        </div>
                                    </td>
                                    <td>@sale.Quantity</td>
                                    <td>@sale.UnitPrice.ToString("C")</td>
                                    <td class="fw-bold text-success">@sale.TotalLine.ToString("C")</td>
                                    <td>@sale.ClientName</td>
                                    <td>
                                        <span class="badge @GetStatusBadge(sale.Status)">
                                            @TranslateStatus(sale.Status)
                                        </span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@code {
    private List<SupplierSaleDto> _sales = new();
    private bool _isLoading = true;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _sales = await Http.GetFromJsonAsync<List<SupplierSaleDto>>("api/Order/sales") ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erro ao carregar vendas: {ex.Message}");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private string GetFullUrl(string path)
    {
        if (string.IsNullOrEmpty(path)) return "";
        if (path.StartsWith("http")) return path;
        return $"{Http.BaseAddress}{path.TrimStart('/')}";
    }

    private static string GetStatusBadge(string status) => status switch
    {
        "Pending" => "bg-warning text-dark",
        "Paid" => "bg-info text-dark",
        "Shipped" => "bg-primary",
        "Delivered" => "bg-success",
        "Cancelled" => "bg-danger",
        _ => "bg-secondary"
    };

    private static string TranslateStatus(string status) => status switch
    {
        "Pending" => "Pendente",
        "Paid" => "Pago",
        "Shipped" => "Enviado",
        "Delivered" => "Entregue",
        "Cancelled" => "Cancelado",
        _ => status
    };
}