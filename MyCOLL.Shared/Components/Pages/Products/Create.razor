@page "/products/create"
@using MyCOLL.Shared.Models.Dto
@using MyCOLL.Shared.Models.Enums
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization

@inject HttpClient Http
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthStateProvider

<div class="container mt-4 mb-5">
    <div class="card shadow">
        <div class="card-header bg-danger text-white">
            <h3>📦 Registar Novo Produto</h3>
        </div>
        <div class="card-body">
            <EditForm Model="@novoProduto" OnValidSubmit="GuardarProduto">
                <DataAnnotationsValidator />
                
                @if (!string.IsNullOrEmpty(mensagemErro))
                {
                    <div class="alert alert-danger">@mensagemErro</div>
                }

                <div class="row">
                    @* Nome *@
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Nome do Produto</label>
                        <InputText @bind-Value="novoProduto.Name" class="form-control" placeholder="Ex: iPhone 15" />
                    </div>

                    @* Categoria (Por enquanto é um número, futuramente será um dropdown) *@
                    <div class="col-md-6 mb-3">
                        <label class="form-label">ID da Categoria</label>
                        <InputNumber @bind-Value="novoProduto.CategoryId" class="form-control" placeholder="Ex: 1" />
                    </div>
                </div>

                @* Descrição *@
                <div class="mb-3">
                    <label class="form-label">Descrição</label>
                    <InputTextArea @bind-Value="novoProduto.Description" class="form-control" rows="3" />
                </div>

                <div class="row">
                    @* Preço Base *@
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Preço Base (€)</label>
                        <InputNumber @bind-Value="novoProduto.BasePrice" class="form-control" />
                    </div>

                    @* Taxa de Venda *@
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Taxa de Venda (%)</label>
                        <InputNumber @bind-Value="novoProduto.SellTax" class="form-control" />
                    </div>

                    @* Stock *@
                    <div class="col-md-4 mb-3">
                        <label class="form-label">Stock Disponível</label>
                        <InputNumber @bind-Value="novoProduto.Stock" class="form-control" />
                    </div>
                </div>

                <div class="row">
                    @* Dropdown para ProductType (Enum) *@
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Tipo de Produto</label>
                        <InputSelect @bind-Value="novoProduto.ProductType" class="form-select">
                            @foreach (var type in Enum.GetValues(typeof(ProductType)))
                            {
                                <option value="@type">@type</option>
                            }
                        </InputSelect>
                    </div>

                    @* Dropdown para AvailabilityMode (Enum) *@
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Disponibilidade</label>
                        <InputSelect @bind-Value="novoProduto.AvailabilityMode" class="form-select">
                            @foreach (var mode in Enum.GetValues(typeof(AvailabilityMode)))
                            {
                                <option value="@mode">@mode</option>
                            }
                        </InputSelect>
                    </div>
                </div>

                @* Checkboxes *@
                <div class="mb-3 form-check">
                    <InputCheckbox @bind-Value="novoProduto.IsUsed" class="form-check-input" id="checkUsed" />
                    <label class="form-check-label" for="checkUsed">É um artigo usado?</label>
                </div>
                
                <div class="mb-3 form-check">
                    <InputCheckbox @bind-Value="novoProduto.IsActive" class="form-check-input" id="checkActive" />
                    <label class="form-check-label" for="checkActive">Produto Ativo (Visível na loja)</label>
                </div>

                @* Botões *@
                <div class="d-grid gap-2 d-md-flex justify-content-md-end">
                    <a href="/" class="btn btn-secondary me-md-2">Cancelar</a>
                    <button type="submit" class="btn btn-success">Salvar Produto</button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private ProductDto novoProduto = new ProductDto 
    { 
        IsActive = true, // Começa ativo por defeito
        ProductType = ProductType.Collectible, // Valor padrão
        AvailabilityMode = AvailabilityMode.Sale
    };
    
    private string mensagemErro = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        // 1. Obter o utilizador atual para preencher o SupplierId automaticamente
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            // Tenta encontrar o ID nos Claims (geralmente ClaimTypes.NameIdentifier)
            var userId = user.FindFirst(c => c.Type == ClaimTypes.NameIdentifier)?.Value;
            var userName = user.FindFirst(c => c.Type == ClaimTypes.Name)?.Value;

            if (!string.IsNullOrEmpty(userId))
            {
                novoProduto.SupplierId = userId;
                novoProduto.SupplierName = userName ?? "Desconhecido";
            }
        }
    }

    private async Task GuardarProduto()
    {
        try
        {
            // Validar se temos o ID do fornecedor
            if (string.IsNullOrEmpty(novoProduto.SupplierId))
            {
                mensagemErro = "Erro: Não foi possível identificar o fornecedor. Faça login novamente.";
                return;
            }

            // Envia para a API
            var response = await Http.PostAsJsonAsync("api/Product", novoProduto);

            if (response.IsSuccessStatusCode)
            {
                NavManager.NavigateTo("/"); // Sucesso! Vai para o início
            }
            else
            {
                var erro = await response.Content.ReadAsStringAsync();
                mensagemErro = $"Erro da API: {erro}";
            }
        }
        catch (Exception ex)
        {
            mensagemErro = $"Erro de conexão: {ex.Message}";
        }
    }
}