@page "/products"
@using StoreManagement.ViewModels
@inject StoreManagement.Services.ApiService ApiService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

<PageTitle>Lista de Produtos</PageTitle>

<h3>Produtos</h3>

<button class="btn btn-primary mb-3" @onclick="AddProduct" disabled="@_isLoading">
    Adicionar Novo Produto
</button>

@if (!string.IsNullOrEmpty(_errorMessage))
{
    <div class="alert alert-danger">@_errorMessage</div>
}

@if (_productsList == null && _isLoading)
{
    <p><em>Carregando produtos...</em></p>
}
else if (_productsList != null && _productsList.Count == 0)
{
    <p><em>Nenhum produto encontrado.</em></p>
}
else
{
    <table class="table">
        <thead>
            <tr>
                <th>Nome</th>
                <th>Preço</th>
                <th>Categorias</th>
                <th>Ações</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in _productsList)
            {
                <tr>
                    <td>@product.Name</td>
                    <td>@product.FinalPrice.ToString("C")</td>
                    <td>@string.Join(", ", product.CategoryNames)</td>
                    <td>
                        <button class="btn btn-sm btn-info" @onclick="() => EditProduct(product.Id)" disabled="@_isLoading">Editar</button>
                        <button class="btn btn-sm btn-danger" @onclick="() => DeleteProducts(product.Id)" disabled="@_isLoading">Deletar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<ProductReadViewModel>? _productsList;
    private bool _isLoading = false;
    private string? _errorMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadProducts();
    }

    private async Task LoadProducts()
    {
        _errorMessage = null;
        try
        {
            _isLoading = true;
            _productsList = await ApiService.GetProductsAsync();
        }
        catch (Exception ex)
        {
            _errorMessage = $"Erro ao carregar produtos: {ex.Message}";
            _productsList = new List<ProductReadViewModel>();
        }
        finally
        {
            _isLoading = false;
            StateHasChanged();
        }
    }

    private void AddProduct()
    {
        NavigationManager.NavigateTo("/product/new");
    }

    private void EditProduct(int id)
    {
        NavigationManager.NavigateTo($"/product/edit/{id}");
    }

    private async Task DeleteProducts(int id)
    {
        try
        {
            var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Deseja realmente excluir este produto?");
            if (!confirmed) return;

            _isLoading = true;
            _errorMessage = null;

            await ApiService.DeleteProductAsync(id);
        }
        catch (Exception ex)
        {
            _errorMessage = $"Erro ao deletar produto: {ex.Message}";
        }
        finally
        {
            _isLoading = false;
            await LoadProducts();
        }
    }
}
