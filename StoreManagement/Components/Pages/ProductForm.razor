@page "/product/new"
@page "/product/edit/{Id:int}"

@using StoreManagement.ViewModels
@inject StoreManagement.Services.ApiService ApiService
@inject NavigationManager NavigationManager
@inject IJSRuntime JSRuntime

@if (IsEditMode)
{
    <h3>Edit Product</h3>
}
else
{
    <h3>New Product</h3>
}

@if (_product == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <EditForm Model="_product" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="mb-3">
            <label class="form-label">Name:</label>
            <InputText class="form-control" @bind-Value="_product.Name" />
        </div>

        <div class="mb-3">
            <label class="form-label">Description:</label>
            <InputTextArea class="form-control" @bind-Value="_product.Description" />
        </div>

        <div class="mb-3">
            <label class="form-label">Base Price:</label>
            <InputNumber class="form-control" @bind-Value="_product.BasePrice" />
        </div>
        
        <div class="mb-3">
            <label class="form-label">Sell Tax:</label>
            <InputNumber class="form-control" @bind-Value="_product.SellTax" />
        </div>
        
        <div class="mb-3">
            <label class="form-label">State:</label>
            <InputText class="form-control" @bind-Value="_product.State" />
        </div>
        
        <div class="mb-3">
            <label class="form-label">Condition:</label>
            <InputText class="form-control" @bind-Value="_product.Condition" />
        </div>

        <div class="mb-3">
            <label class="form-label">Category:</label>
            @if (_categories == null)
            {
                <p>Loading categories...</p>
            }
            else
            {
                <InputSelect class="form-select" @bind-Value="_product.CategoryId">
                    <option value="0">-- Select a category --</option>
                    @foreach (var cat in _categories)
                    {
                        <option value="@cat.Id">@cat.Name</option>
                    }
                </InputSelect>
            }
        </div>

        <button type="submit" class="btn btn-success">Save</button>
        <button type="button" class="btn btn-secondary" @onclick="GoBack">Cancel</button>

    </EditForm>
}

@code {
    [Parameter]
    public int? Id { get; set; }

    private ProductViewModel? _product = new ProductViewModel();
    private List<CategoryViewModel>? _categories;
    private bool IsEditMode => Id.HasValue;

    protected override async Task OnInitializedAsync()
    {
        _categories = await ApiService.GetCategoriesAsync();

        if (IsEditMode)
        {
            _product = await ApiService.GetProductByIdAsync(Id.Value);
        }
        else
        {
            _product = new ProductViewModel();
        }
    }

    private async Task HandleSubmit()
    {
        try
        {
            if (IsEditMode)
            {
                await ApiService.UpdateProductAsync(Id.Value, _product!);
            }
            else
            {
                await ApiService.CreateProductAsync(_product!);
            }

            GoBack();
        }
        catch (Exception ex)
        {
            await JSRuntime.InvokeVoidAsync("alert", $"Error saving: {ex.Message}");
        }
    }

    private void GoBack()
    {
        NavigationManager.NavigateTo("/products");
    }
}
